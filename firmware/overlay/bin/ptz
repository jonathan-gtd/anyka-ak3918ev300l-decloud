#!/bin/sh
# ptz - pan/tilt control of the dome (two steppers). Positions are in half-steps:
#   pan  : 0 = "-" end stop .. PTZ_MAX           (PTZ_CENTER = straight ahead)
#   tilt : 0 = end stop .. TILT_MAX, TILT_H = position looking at the horizon (set it with ptz-calib, key h)
#   ptz home                      both axes to their end stops, then to the home position (also run at boot)
#   ptz left|right|up|down [spd]  continuous move (as seen in the image) until "ptz stop" or the end of travel
#   ptz stop                      stop all moves
#   ptz goto P [T]                absolute position          ptz rel DP [DT]   relative move
#   ptz fov DX DY                 centre the image point DX,DY (-1..1, right/up +), exact dome geometry (ptzmath)
#   ptz center | pos ("P,T,0") | moving (1/0) | wait
#   ptz preset set N NAME | goto N | del N | list   (/conf/ptz_presets: "N=NAME P,T,0")
#   ptz jog left|right|up|down N   raw move ignoring the limits    ptz mark center|horizon|panmax|tiltmax
#   ptz set VAR VALUE | conf      change / show the settings below (web UI: http://<cam>/ui/)
# Settings (/conf/ptz.conf overrides any variable below)
PAN_PINS=50,24,25,27
PAN_DELAY=2500
PAN_RAMP=0          # half-steps of acceleration/deceleration, 0 = constant speed
PTZ_MAX=4340
PTZ_CENTER=2410
TILT_PINS=65,66,26,58
TILT_DELAY=4000
TILT_RAMP=0
TILT_MAX=2048       # factory: 180 deg of tilt travel
TILT_H=1424
TILT_HOME=1424
HFOV=94
VFOV=62
DEG_PER_STEP=0.087890625
PAN_LEFT=1          # 1: pan "+" turns the view to the left (this unit), 0: to the right
TILT_DOWN=1         # 1: tilt "+" (away from the end stop) turns the view down (this unit), 0: up
IMG_ROT180=0        # 1 if the image is rotated 180 degrees (e.g. a flipped sensor image)
MIN_MOVE_CS=60      # continuous moves last at least this long (1/100 s): a short tap in Frigate still moves
[ -f /conf/ptz.conf ] && . /conf/ptz.conf
D=/tmp/ptz; mkdir -p $D
PRESETS=/conf/ptz_presets
STEPPER=/app/bin/stepper

pan()    { cat $D/pan 2>/dev/null || echo $PTZ_CENTER; }
tilt()   { cat $D/tilt 2>/dev/null || echo $TILT_HOME; }
moving() { for a in pan tilt; do [ -f $D/run_$a ] && kill -0 "$(cat $D/run_$a 2>/dev/null)" 2>/dev/null && return 0; done; return 1; }
clamp()  { v=$1; [ $v -lt 0 ] && v=0; [ $v -gt $2 ] && v=$2; echo $v; }
int()    { v=${1%%.*}; case "$v" in ''|-) echo 0 ;; *) echo $v ;; esac; }
neg()    { case "$1" in -*) echo ${1#-} ;; *) echo -$1 ;; esac; }
now_cs() { read u _ < /proc/uptime; echo ${u%.*}${u#*.}; }

stop() {
    moving || return 0
    killall stepper 2>/dev/null
    i=0; while moving && [ $i -lt 30 ]; do usleep 100000; i=$((i+1)); done
}

# axis_to AXIS TARGET : background move, the worker stores the real position when the stepper exits.
# tilt counts up towards the horizon while the motor turns the "-" way, hence the sign flip.
axis_to() {
    a=$1
    if [ $a = pan ]; then t=$(clamp $2 $PTZ_MAX); p=$(pan);  pins=$PAN_PINS;  dl="$PAN_DELAY full $PAN_RAMP";   sg=1
    else                  t=$(clamp $2 $TILT_MAX); p=$(tilt); pins=$TILT_PINS; dl="$TILT_DELAY full $TILT_RAMP"; sg=-1; fi
    n=$((t - p)); [ $n -eq 0 ] && return 0
    mx=$PTZ_MAX; [ $a = tilt ] && mx=$TILT_MAX
    (
        out=$($STEPPER $pins $((sg * n)) $dl 2>/dev/null)
        done=$(echo "$out" | sed -n 's/.*: \(-*[0-9]*\) half-steps done/\1/p')
        echo $(clamp $((p + sg * ${done:-0})) $mx) > $D/$a
        rm -f $D/run_$a
    ) &
    echo $! > $D/run_$a
}
move_to() { rm -f $D/cont; stop; axis_to pan "$1"; [ -n "$2" ] && axis_to tilt "$2"; }
wait_move() { while moving; do usleep 100000; done; }

case "$1" in
    home)
        stop
        $STEPPER $PAN_PINS -$((PTZ_MAX + 150)) $PAN_DELAY full $PAN_RAMP >/dev/null 2>&1    # pan into its "-" end stop (pan 0)
        echo 0 > $D/pan
        $STEPPER $TILT_PINS $((TILT_MAX + 100)) $TILT_DELAY full $TILT_RAMP >/dev/null 2>&1 # tilt into the "+" stop
        echo 0 > $D/tilt
        h=$(sed -n 's/^1=[^ ]* \([0-9]*\),\([0-9]*\),.*/\1 \2/p' $PRESETS 2>/dev/null)
        [ -n "$h" ] && move_to $h || move_to $PTZ_CENTER $TILT_HOME
        wait_move ;;
    center) h=$(sed -n 's/^1=[^ ]* \([0-9]*\),\([0-9]*\),.*/\1 \2/p' $PRESETS 2>/dev/null)
            [ -n "$h" ] && move_to $h || move_to $PTZ_CENTER $TILT_HOME ;;
    left|right|up|down)                   # directions as seen in the image
        stop; d=$1; now_cs > $D/cont
        if [ "$IMG_ROT180" = 1 ]; then case $d in left) d=right ;; right) d=left ;; up) d=down ;; down) d=up ;; esac; fi
        [ "$PAN_LEFT" = 1 ]  && { L=$PTZ_MAX; Rt=0; } || { L=0; Rt=$PTZ_MAX; }
        [ "$TILT_DOWN" = 1 ] && { Up=0; Dn=$TILT_MAX; } || { Up=$TILT_MAX; Dn=0; }
        case $d in left) axis_to pan $L ;; right) axis_to pan $Rt ;; up) axis_to tilt $Up ;; down) axis_to tilt $Dn ;; esac ;;
    stop)   if [ -f $D/cont ]; then             # end of a continuous move: honour the minimum duration
                w=$(( $(cat $D/cont) + MIN_MOVE_CS - $(now_cs) )); rm -f $D/cont
                [ $w -gt 0 ] && usleep $((w * 10000))
            fi
            stop ;;
    goto)   move_to $(int $2) ${3:+$(int $3)} ;;
    rel)    move_to $(( $(pan) + $(int $2) )) $(( $(tilt) + $(int ${3:-0}) )) ;;
    fov)    fx=${2:-0}; fy=${3:-0}
            [ "$IMG_ROT180" = 1 ] && { fx=$(neg $fx); fy=$(neg $fy); }
            set -- $(/app/bin/ptzmath $(pan) $(tilt) $fx $fy $PTZ_CENTER $PTZ_MAX $TILT_H $TILT_MAX $HFOV $VFOV $DEG_PER_STEP $PAN_LEFT $TILT_DOWN)
            [ -n "$2" ] && move_to $1 $2 ;;
    pos)    echo "$(pan),$(tilt),0" ;;
    moving) moving && echo 1 || echo 0 ;;
    wait)   wait_move ;;
    jog)    # jog left|right|up|down N : raw move as seen in the image, ignores the travel limits (calibration)
        rm -f $D/cont; stop; d=$2; n=$(int ${3:-20}); n=${n#-}
        if [ "$IMG_ROT180" = 1 ]; then case $d in left) d=right ;; right) d=left ;; up) d=down ;; down) d=up ;; esac; fi
        case $d in
            left|right) s=1; [ "$PAN_LEFT" = 1 ] || s=-1; [ $d = right ] && s=$((-s))
                        out=$($STEPPER $PAN_PINS $((s * n)) $PAN_DELAY full $PAN_RAMP)
                        k=$(echo "$out" | sed -n 's/.*: \(-*[0-9]*\) half-steps done/\1/p'); echo $(( $(pan) + ${k:-0} )) > $D/pan ;;
            up|down)    s=1; [ "$TILT_DOWN" = 1 ] || s=-1; [ $d = up ] && s=$((-s))
                        out=$($STEPPER $TILT_PINS $((-s * n)) $TILT_DELAY full $TILT_RAMP)
                        k=$(echo "$out" | sed -n 's/.*: \(-*[0-9]*\) half-steps done/\1/p'); echo $(( $(tilt) - ${k:-0} )) > $D/tilt ;;
            *) echo "usage: ptz jog left|right|up|down N"; exit 1 ;;
        esac ;;
    set)    # set VAR VALUE : change one setting in /conf/ptz.conf (integers only)
        case "$2" in PAN_DELAY|TILT_DELAY|PAN_RAMP|TILT_RAMP|PTZ_CENTER|PTZ_MAX|TILT_H|TILT_HOME|TILT_MAX|PAN_LEFT|TILT_DOWN|IMG_ROT180|HFOV|VFOV|MIN_MOVE_CS) ;;
            *) echo "unknown setting $2"; exit 1 ;; esac
        case "$3" in ''|*[!0-9]*) echo "bad value $3"; exit 1 ;; esac
        touch /conf/ptz.conf; grep -v "^$2=" /conf/ptz.conf > $D/conf; echo "$2=$3" >> $D/conf; cp $D/conf /conf/ptz.conf
        eval "$2=$3"
        case "$2" in PTZ_CENTER|TILT_HOME)                 # preset 1 "home" follows straight ahead / home tilt
            touch $PRESETS; grep -v "^1=" $PRESETS > $D/pr; echo "1=home $PTZ_CENTER,$TILT_HOME,0" >> $D/pr; cp $D/pr $PRESETS ;; esac
        echo "$2=$3" ;;
    mark)   # mark center|horizon|panmax|tiltmax : the current position becomes that calibration point
        case "$2" in
            center)  exec "$0" set PTZ_CENTER $(pan) ;;
            horizon) "$0" set TILT_H $(tilt); exec "$0" set TILT_HOME $(tilt) ;;
            panmax)  exec "$0" set PTZ_MAX $(pan) ;;
            tiltmax) exec "$0" set TILT_MAX $(tilt) ;;
            *) echo "usage: ptz mark center|horizon|panmax|tiltmax"; exit 1 ;;
        esac ;;
    conf)   # effective settings
        for v in PAN_DELAY TILT_DELAY PAN_RAMP TILT_RAMP PTZ_CENTER PTZ_MAX TILT_H TILT_HOME TILT_MAX PAN_LEFT TILT_DOWN IMG_ROT180 HFOV VFOV MIN_MOVE_CS; do
            eval echo "$v=\$$v"
        done ;;
    preset)
        touch $PRESETS
        case "$2" in
            set)  n=$3
                  case "$n" in ''|-*|*[!0-9]*)            # no number from the client: first free slot 1..8
                      n=1; while [ $n -lt 8 ] && grep -q "^$n=" $PRESETS; do n=$((n+1)); done ;; esac
                  grep -v "^$n=" $PRESETS > $D/pr; echo "$n=${4:-Preset_$n} $(pan),$(tilt),0" >> $D/pr; cp $D/pr $PRESETS ;;
            goto) xy=$(sed -n "s/^$3=[^ ]* \([0-9]*\),\([0-9]*\),.*/\1 \2/p" $PRESETS); [ -n "$xy" ] && move_to $xy ;;
            del)  grep -v "^$3=" $PRESETS > $D/pr; cp $D/pr $PRESETS ;;
            list) cat $PRESETS ;;
            *)    echo "usage: ptz preset set N NAME|goto N|del N|list"; exit 1 ;;
        esac ;;
    *) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
