#!/bin/sh
# ptz - pan/tilt control of the dome (two steppers). Positions are in half-steps:
#   pan  : 0 = left end stop .. PTZ_MAX          (PTZ_CENTER = straight ahead)
#   tilt : 0 = dome axis (straight down when ceiling-mounted) .. TILT_MAX, TILT_H = horizon
#   ptz home                      both axes to their end stops, then to the home position (also run at boot)
#   ptz left|right|up|down [spd]  continuous move (as seen in the image) until "ptz stop" or the end of travel
#   ptz stop                      stop all moves
#   ptz goto P [T]                absolute position          ptz rel DP [DT]   relative move
#   ptz fov DX DY                 centre the image point DX,DY (-1..1, right/up +), exact dome geometry (ptzmath)
#   ptz center | pos ("P,T,0") | moving (1/0) | wait
#   ptz preset set N NAME | goto N | del N | list   (/conf/ptz_presets: "N=NAME P,T,0")
# Settings (/conf/ptz.conf overrides any variable below)
PAN_PINS=50,24,25,27
PAN_DELAY=1300
PTZ_MAX=4340
PTZ_CENTER=2170
TILT_PINS=65,66,26,58
TILT_DELAY=5000
TILT_MAX=1100
TILT_H=1024
TILT_HOME=1024
HFOV=94
VFOV=62
DEG_PER_STEP=0.087890625
IMG_ROT180=0        # 1 if the image is rotated 180 degrees (ceiling mount with image flip)
[ -f /conf/ptz.conf ] && . /conf/ptz.conf
D=/tmp/ptz; mkdir -p $D
PRESETS=/conf/ptz_presets
STEPPER=/app/bin/stepper

pan()    { cat $D/pan 2>/dev/null || echo $PTZ_CENTER; }
tilt()   { cat $D/tilt 2>/dev/null || echo $TILT_HOME; }
moving() { for a in pan tilt; do [ -f $D/run_$a ] && kill -0 "$(cat $D/run_$a)" 2>/dev/null && return 0; done; return 1; }
clamp()  { v=$1; [ $v -lt 0 ] && v=0; [ $v -gt $2 ] && v=$2; echo $v; }
int()    { v=${1%%.*}; case "$v" in ''|-) echo 0 ;; *) echo $v ;; esac; }
neg()    { case "$1" in -*) echo ${1#-} ;; *) echo -$1 ;; esac; }

stop() {
    moving || return 0
    killall stepper 2>/dev/null
    i=0; while moving && [ $i -lt 30 ]; do usleep 100000; i=$((i+1)); done
}

# axis_to AXIS TARGET : background move, the worker stores the real position when the stepper exits.
# tilt counts up towards the horizon while the motor turns the "-" way, hence the sign flip.
axis_to() {
    a=$1
    if [ $a = pan ]; then t=$(clamp $2 $PTZ_MAX); p=$(pan);  pins=$PAN_PINS;  dl=$PAN_DELAY;  sg=1
    else                  t=$(clamp $2 $TILT_MAX); p=$(tilt); pins=$TILT_PINS; dl=$TILT_DELAY; sg=-1; fi
    n=$((t - p)); [ $n -eq 0 ] && return 0
    mx=$PTZ_MAX; [ $a = tilt ] && mx=$TILT_MAX
    (
        out=$($STEPPER $pins $((sg * n)) $dl 2>/dev/null)
        done=$(echo "$out" | sed -n 's/.*: \(-*[0-9]*\) half-steps done/\1/p')
        echo $(clamp $((p + sg * ${done:-0})) $mx) > $D/$a
        rm -f $D/run_$a
    ) &
    echo $! > $D/run_$a
}
move_to() { stop; axis_to pan "$1"; [ -n "$2" ] && axis_to tilt "$2"; }
wait_move() { while moving; do usleep 100000; done; }

case "$1" in
    home)
        stop
        $STEPPER $PAN_PINS -$((PTZ_MAX + 150)) $PAN_DELAY >/dev/null 2>&1    # pan into the left stop
        echo 0 > $D/pan
        $STEPPER $TILT_PINS $((TILT_MAX + 100)) $TILT_DELAY >/dev/null 2>&1 # tilt into the dome-axis stop
        echo 0 > $D/tilt
        h=$(sed -n 's/^1=[^ ]* \([0-9]*\),\([0-9]*\),.*/\1 \2/p' $PRESETS 2>/dev/null)
        [ -n "$h" ] && move_to $h || move_to $PTZ_CENTER $TILT_HOME
        wait_move ;;
    center) h=$(sed -n 's/^1=[^ ]* \([0-9]*\),\([0-9]*\),.*/\1 \2/p' $PRESETS 2>/dev/null)
            [ -n "$h" ] && move_to $h || move_to $PTZ_CENTER $TILT_HOME ;;
    left|right|up|down)                   # directions as seen in the image (raw: pan + = right, tilt "+" stop = up)
        stop; d=$1
        if [ "$IMG_ROT180" = 1 ]; then case $d in left) d=right ;; right) d=left ;; up) d=down ;; down) d=up ;; esac; fi
        case $d in left) axis_to pan 0 ;; right) axis_to pan $PTZ_MAX ;; up) axis_to tilt 0 ;; down) axis_to tilt $TILT_MAX ;; esac ;;
    stop)   stop ;;
    goto)   move_to $(int $2) ${3:+$(int $3)} ;;
    rel)    move_to $(( $(pan) + $(int $2) )) $(( $(tilt) + $(int ${3:-0}) )) ;;
    fov)    fx=${2:-0}; fy=${3:-0}
            [ "$IMG_ROT180" = 1 ] && { fx=$(neg $fx); fy=$(neg $fy); }
            set -- $(/app/bin/ptzmath $(pan) $(tilt) $fx $fy $PTZ_CENTER $PTZ_MAX $TILT_H $TILT_MAX $HFOV $VFOV $DEG_PER_STEP)
            [ -n "$2" ] && move_to $1 $2 ;;
    pos)    echo "$(pan),$(tilt),0" ;;
    moving) moving && echo 1 || echo 0 ;;
    wait)   wait_move ;;
    preset)
        touch $PRESETS
        case "$2" in
            set)  n=$3
                  case "$n" in ''|-*|*[!0-9]*)            # no number from the client: first free slot 1..8
                      n=1; while [ $n -lt 8 ] && grep -q "^$n=" $PRESETS; do n=$((n+1)); done ;; esac
                  grep -v "^$n=" $PRESETS > $D/pr; echo "$n=${4:-Preset_$n} $(pan),$(tilt),0" >> $D/pr; cp $D/pr $PRESETS ;;
            goto) xy=$(sed -n "s/^$3=[^ ]* \([0-9]*\),\([0-9]*\),.*/\1 \2/p" $PRESETS); [ -n "$xy" ] && move_to $xy ;;
            del)  grep -v "^$3=" $PRESETS > $D/pr; cp $D/pr $PRESETS ;;
            list) cat $PRESETS ;;
            *)    echo "usage: ptz preset set N NAME|goto N|del N|list"; exit 1 ;;
        esac ;;
    *) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
